  "targets": [
    {
      "name": "Cryptomator",
      "id": "4AE97DA724572E4900452814",
      "product": "Products/Cryptomator.app",
      "product-type": "application",
      "dependencies": [
        "FileProviderExtension",
        "FileProviderExtensionUI",
        "CryptomatorIntents",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        }, {
          "kind": "script",
          "name": "Add URL Schemes",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(INFOPLIST_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "if [ -f ./fastlane/scripts/.cloud-access-secrets.sh ]; then",
            "  source ./fastlane/scripts/.cloud-access-secrets.sh \"${CONFIG_NAME}\"",
            "else",
            "  echo \"warning: .cloud-access-secrets.sh could not be found, please see README for instructions\"",
            "fi",
            "/usr/libexec/PlistBuddy -c \"Add :CFBundleURLTypes:1:CFBundleURLSchemes:0 string db-${DROPBOX_APP_KEY}\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "/usr/libexec/PlistBuddy -c \"Add :CFBundleURLTypes:1:CFBundleURLSchemes:1 string ${GOOGLE_DRIVE_REDIRECT_URL_SCHEME}\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "/usr/libexec/PlistBuddy -c \"Add :CFBundleURLTypes:1:CFBundleURLSchemes:2 string ${MICROSOFT_GRAPH_REDIRECT_URI_SCHEME}\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "/usr/libexec/PlistBuddy -c \"Add :CFBundleURLTypes:1:CFBundleURLSchemes:3 string ${HUB_REDIRECT_URI_SCHEME}\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "echo \"Updated ${TARGET_BUILD_DIR}/${INFOPLIST_PATH} by adding URL schemes\"",
            "",
          ],
        }, {
          "kind": "script",
          "name": "Set Build Number",
          "log-environment-variables": true,
          "input-paths": [
            "$(TARGET_BUILD_DIR)/$(INFOPLIST_PATH)",
          ],
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "git=`sh /etc/profile; which git`",
            "branchName=`\"$git\" rev-parse --abbrev-ref HEAD`",
            "appBuild=`\"$git\" rev-list --count $branchName`",
            "if [ $CONFIGURATION = \"Debug\" ]; then",
            "/usr/libexec/PlistBuddy -c \"Set :CFBundleVersion $appBuild-$branchName\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "else",
            "/usr/libexec/PlistBuddy -c \"Set :CFBundleVersion $appBuild\" \"${TARGET_BUILD_DIR}/${INFOPLIST_PATH}\"",
            "fi",
            "echo \"Updated ${TARGET_BUILD_DIR}/${INFOPLIST_PATH} by setting build number\"",
            "",
          ],
        },
      ],
      "package-product-members": [
        {
          "product-name": "CryptomatorCommon",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "TPInAppReceipt",
          "product-name": "TPInAppReceipt",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_ENTITLEMENTS": "Cryptomator/Cryptomator.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "iPhone Developer",
        "CODE_SIGN_IDENTITY[config=Release]": "iPhone Distribution",
        "CODE_SIGN_STYLE": "Manual",
        "DEVELOPMENT_TEAM": "YZQJQUHA3L",
        "INFOPLIST_FILE": "Cryptomator/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "org.cryptomator.ios",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER[config=Debug]": "match Development org.cryptomator.ios",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "match AppStore org.cryptomator.ios",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
      },
